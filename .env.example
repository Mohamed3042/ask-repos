# --- storage -----------------------------------------------------------------
# PostgreSQL 16 with the pgvector extension. `docker compose up -d db` provides this and
# publishes it on host port 5433, so it never collides with a local PostgreSQL on 5432.
DATABASE_URL=postgresql+psycopg://askrepos:askrepos@localhost:5433/askrepos

# --- ingestion ---------------------------------------------------------------
# Optional. Anonymous GitHub gives 60 requests/hour; a token gives 5,000.
# Only PUBLIC repositories are ever indexed, whatever the token can see.
GITHUB_TOKEN=
# The account whose public repositories `docker compose up` indexes on first boot.
ASK_REPOS_OWNER=Mohamed3042
# Files larger than this are skipped (bytes).
ASK_REPOS_MAX_FILE_BYTES=200000

# --- models (local ONNX, no key, no network after first download) ------------
ASK_REPOS_EMBED_MODEL=BAAI/bge-small-en-v1.5
ASK_REPOS_EMBED_DIM=384
ASK_REPOS_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ASK_REPOS_RERANK=1
ASK_REPOS_MODEL_CACHE=

# --- generation (optional; without it answers are extractive) ----------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_S=60

# --- service -----------------------------------------------------------------
# Required for POST /v1/index and the webhook admin routes. Unset = those routes 503.
ASK_REPOS_API_KEY=
# HMAC secret shared with the GitHub push webhook. Unset = the webhook route 503s.
ASK_REPOS_WEBHOOK_SECRET=
# Comma-separated browser origins allowed to call the API (the UI lane sets this).
ASK_REPOS_CORS_ORIGINS=
# none | console | otlp
ASK_REPOS_OTEL_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
